# Optional extra: the MCP server (broker_engine.main.build_mcp_server). It is not served and the
# image does not install it; install it with `pip install -r requirements-mcp.txt`.
# requirements-mcp.txt is generated from this file, with every release file hash:
#   pip-compile --generate-hashes --strip-extras --output-file=requirements-mcp.txt requirements-mcp.in
# using pip-tools in a throwaway virtual environment outside this repository. The -c line makes
# every package it shares with the default install list the same version as requirements.txt.
-c requirements.txt
-r requirements.in
mcp==2.3.0
