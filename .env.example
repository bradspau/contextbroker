# Anthropic API key for the agent CLI (broker.py); leave empty if using LM Studio
ANTHROPIC_API_KEY=
# Anthropic model used by the agent loop
MODEL_NAME=claude-opus-5
# Local LM Studio OpenAI-compatible endpoint (optional fallback)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Model identifier loaded in LM Studio (optional fallback)
LMSTUDIO_MODEL=
# Fuseki SPARQL query endpoint used by the broker engine
FUSEKI_QUERY_ENDPOINT=http://localhost:3030/network-dataset/query
# VictoriaMetrics instant-query endpoint used by the broker engine
VM_QUERY_ENDPOINT=http://localhost:8428/api/v1/query
# Telemetry retention. One value that compose gives to VictoriaMetrics (-retentionPeriod) and to the
# API (the furthest back as_of may reach). Digits then h or d, at least 1d, for example 30d. A bare
# number is refused because VictoriaMetrics would read it as months. Changing it from the implicit
# 31-day default to 30d drops the oldest day of telemetry the first time VictoriaMetrics starts with the flag.
BROKER_RETENTION_PERIOD=30d
# TMF921 server (compose profile tmf921)
# Checkout of BBF_921_java used as docker build context
TMF921_SRC=../BBF_921_java
# Directory with the licensed TIO .ttl files, bind-mounted read-only (never committed)
TIO_ONTOLOGY_DIR=../BBF_921_java/ontology
# Intent evaluation engine: java | jena | compare
INTENT_EVALUATOR=java
# TMF921 intent API base URL used by the broker
TMF921_BASE_URL=http://localhost:8000/tmf-api/intentManagement/v5
# Metric map (TMF921 metric URI -> broker metric name); default data_contracts/metric_map.json
# METRIC_MAP_PATH=

# Fuseki credential (user admin). Required, letters and digits only, no default:
# docker compose refuses to run without it. Generate with: openssl rand -hex 24
# Also export it in your shell before load_ontologies, seed_graph.py or bind_intent.
FUSEKI_ADMIN_PASSWORD=

# REST authentication (bearer tokens, RS256 or ES256). The API holds the public key only.
# Host path of the public key PEM, outside the repository; unset means no key and every /context/* call is 401.
# The private key never goes in .env or the repository (see README, Authentication).
HOST_BROKER_JWT_PUBLIC_KEY=
# Issuer the API requires in every token; unset means no key is usable
BROKER_JWT_ISSUER=
# Audience the API requires in every token
BROKER_JWT_AUDIENCE=context-broker
