# Fuseki service configuration for the broker's network graph (bead contextbroker-oiq).
# Two users come from the password file docker-compose.yml writes at start-up:
#   admin   may query, update and use the graph store endpoint (the operator tools)
#   reader  may query only (the API and the LodLive proxy)
# Every other request is refused (401 without a credential, 403 for a user the endpoint does not allow).
# The database directory is the one the earlier command line used, so the stored graph is unchanged.
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>

<#service> a fuseki:Service ;
    fuseki:name "network-dataset" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ;
                      fuseki:name "query" ;
                      fuseki:allowedUsers "admin", "reader" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ;
                      fuseki:name "update" ;
                      fuseki:allowedUsers "admin" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ;
                      fuseki:name "data" ;
                      fuseki:allowedUsers "admin" ] ;
    fuseki:dataset <#dataset> .

<#dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki-base/databases" .
